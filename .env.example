# OUTBREAK — environment config. Copy to ".env" for local overrides.
# Client-visible vars MUST be prefixed with VITE_ (Vite only exposes those to the bundle).

# --- Game Master brain ---
# Leave UNSET for "auto": the game probes for a local Ollama and uses it if it's
# running, otherwise the offline procedural GM. Force it with one of:
#   auto (default) | ollama | mock
# VITE_AI_PROVIDER=auto

# --- Local Ollama (the real AI; free, offline, uncensored) ---
# By default the browser calls the SAME-ORIGIN path "/ollama", which the Vite
# dev/preview server proxies to http://127.0.0.1:11434 — so there is NO browser
# CORS to configure. Only set this to an absolute URL if Ollama runs elsewhere
# (then start Ollama with OLLAMA_ORIGINS=* so it accepts the page origin).
# VITE_OLLAMA_HOST=http://localhost:11434

# Model for the GM. Leave UNSET to auto-pick the first installed model
# (pull one first, e.g. `ollama pull llama3.1`). Set to pin a specific model.
# VITE_OLLAMA_MODEL=llama3.1

# Proxy target for the dev/preview server, only if Ollama isn't on the default
# 127.0.0.1:11434 (server-side var; not exposed to the browser).
# OLLAMA_HOST=http://127.0.0.1:11434
