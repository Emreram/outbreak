# OUTBREAK — environment config.
# Copy to ".env" for local overrides. All client-visible vars MUST be prefixed
# with VITE_ (Vite only exposes those to the browser bundle).

# Which Game Master brain to use: "ollama" (default, local, free) or "claude" (optional cloud).
VITE_AI_PROVIDER=ollama

# Local Ollama HTTP API (default install). No API key needed.
VITE_OLLAMA_HOST=http://localhost:11434

# Local model to run the GM. Pull it first, e.g. `ollama pull llama3.1`.
# Use an abliterated/uncensored build for unfiltered horror narration (CLAUDE.md §8.8).
VITE_OLLAMA_MODEL=llama3.1

# --- OPTIONAL cloud path only (CLAUDE.md §8.1) ---
# Used by the optional /server proxy, NEVER the browser. Leave unset for local play.
# ANTHROPIC_API_KEY=sk-ant-...
